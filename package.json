{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "description": "JavaScript and Playwright testing portfolio: UI, API, accessibility and responsive checks against public demo applications",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "test:ui-tests": "playwright test tests/ui/",
    "test:api-tests": "playwright test tests/api/",
    "test:quality": "playwright test tests/quality/",
    "test:docs": "playwright test --project=docs",
    "test:edge-cases": "playwright test tests/ui/edge-cases.spec.js",
    "test:negative": "playwright test tests/ui/negative.spec.js",
    "test:data-driven": "playwright test tests/ui/data-driven.spec.js",
    "test:usability": "playwright test tests/ui/usability.spec.js",
    "test:accessibility": "playwright test tests/ui/accessibility.spec.js",
    "test:robust-api": "playwright test tests/api/robust-api.spec.js",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:ci": "playwright test --reporter=dot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perezbenedict/qa-automation-portfolio.git"
  },
  "keywords": [
    "playwright",
    "javascript",
    "qa",
    "test-automation",
    "api-testing",
    "accessibility",
    "e2e-testing"
  ],
  "author": "Perez Benedict",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/perezbenedict/qa-automation-portfolio/issues"
  },
  "homepage": "https://github.com/perezbenedict/qa-automation-portfolio#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0"
  }
}
